# URL base do backend FastAPI (usada apenas no servidor Next / proxy)
API_ORIGIN=https://ppb.api.onaka.ao

NEXT_PUBLIC_API_URL=https://ppb.api.onaka.ao/api

# Prefixo relativo usado pelo browser para chegar ao backend (rewrite no next.config.ts)
NEXT_PUBLIC_API_PREFIX=/backend

# URL pública do site (canonical, sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: Google Analytics (só é carregado após consentimento de cookies)
NEXT_PUBLIC_GA_ID=